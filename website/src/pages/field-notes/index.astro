---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cards = (await getCollection('cards')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Field Notes — Alejandro Berrizbeitia"
  description="Distilled lessons from a career in data and decisions. One core idea per card, written to be cited and projected."
>
  <main class="mx-auto max-w-2xl px-6 py-14 md:py-20">
    <h1 class="font-serif text-3xl font-semibold text-midnight dark:text-silver">Field Notes</h1>
    <p class="mt-4 leading-relaxed text-ink-muted dark:text-silver">
      Distilled lessons from a career in data and decisions. One core idea per
      card, written to be cited and projected.
    </p>

    <ul class="mt-12 space-y-8">
      {
        cards.map((card) => (
          <li class="border-b border-silver/30 pb-8 last:border-0 dark:border-silver/15">
            <a href={`/field-notes/${card.slug}/`} class="group block">
              <h2 class="font-serif text-xl font-semibold text-midnight group-hover:underline dark:text-silver">
                {card.data.title}
              </h2>
              <p class="mt-2 leading-relaxed text-ink-muted dark:text-silver">
                {card.data.summary}
              </p>
              <p class="mt-2 text-sm text-ink-muted dark:text-silver">
                {card.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
                {card.data.tag && ` · ${card.data.tag}`}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
