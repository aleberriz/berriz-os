---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BareLayout from '../../layouts/BareLayout.astro';
import { getCollection } from 'astro:content';
import { byFeaturedThenDate } from '../../lib/fieldNotes';


export async function getStaticPaths() {
  const cards = (await getCollection('cards')).sort(byFeaturedThenDate);
  return cards.map((card, i) => ({
    params: { slug: card.slug },
    props: {
      card,
      newer: cards[i - 1] ?? null,
      older: cards[i + 1] ?? null,
    },
  }));
}

const { card, newer, older } = Astro.props;
const { Content } = await card.render();
const isBare = card.data.display === 'bare';
const dateStr = card.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const pageTitle = `${card.data.title} — Field Notes`;
---

{isBare ? (
  <BareLayout title={pageTitle} description={card.data.summary}>
    <Content />
  </BareLayout>
) : (
  <BaseLayout title={pageTitle} description={card.data.summary}>
    <main class="fn-card mx-auto max-w-2xl px-6 py-14 md:py-20">
      <article>
        <p class="text-sm text-ink-muted">{dateStr}</p>
        <h1
          class="fn-card__title mt-2 font-serif text-3xl font-semibold tracking-tight text-ink md:text-4xl"
        >
          {card.data.title}
        </h1>
        <p class="fn-card__summary mt-4 font-serif text-lg leading-relaxed text-ink-body md:text-xl">
          {card.data.summary}
        </p>
        {card.data.image && (
          <figure class="fn-card__image mt-8">
            <img
              src={card.data.image}
              alt={card.data.imageAlt ?? card.data.title}
              class="w-full rounded-lg"
              loading="lazy"
            />
          </figure>
        )}
        <div class="fn-card__body mt-8 text-base leading-relaxed text-ink-body md:text-lg">
          <Content />
        </div>
      </article>

      <nav class="fn-nav mt-16 flex flex-col gap-3 border-t border-line pt-6 text-sm sm:flex-row sm:justify-between sm:gap-6">
        {newer ? (
          <a href={`/field-notes/${newer.slug}/`} class="text-accent underline underline-offset-4 hover:text-accent-hover">
            ← {newer.data.title}
          </a>
        ) : <span />}
        {older ? (
          <a href={`/field-notes/${older.slug}/`} class="text-accent underline underline-offset-4 hover:text-accent-hover">
            {older.data.title} →
          </a>
        ) : <span />}
      </nav>

      <p class="fn-nav mt-8 text-sm text-ink-muted">
        <a href="/field-notes/" class="text-accent underline underline-offset-4 hover:text-accent-hover">All field notes</a>
        <span class="mx-2">·</span>
        <a href={`/field-notes/${card.slug}/?present`} class="text-accent underline underline-offset-4 hover:text-accent-hover">
          Present mode
        </a>
      </p>
    </main>
  </BaseLayout>
)}

<script is:inline>
  if (new URLSearchParams(location.search).has('present')) {
    document.documentElement.classList.add('present');
  }
</script>

<style is:global>
  html.present header,
  html.present footer {
    display: none !important;
  }
  html.present .fn-card {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: none;
    padding: 3rem 2rem;
  }
  html.present .fn-card__title {
    font-size: 3.25rem;
    line-height: 1.1;
  }
  html.present .fn-card__summary {
    font-size: 1.75rem;
  }
  html.present .fn-card__body {
    font-size: 1.375rem;
  }
  html.present .fn-card__image img {
    max-height: 60vh;
    object-fit: contain;
  }
  html.present .fn-nav {
    display: none;
  }
</style>
