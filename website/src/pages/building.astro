---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHubProjects } from '../lib/hubProjects';

const projects = getHubProjects();

function statusLabel(status: string): string {
  if (status === 'active') return 'Active';
  if (status === 'planned') return 'Planned';
  if (status === 'maintenance') return 'Maintenance';
  if (status === 'archived') return 'Archived';
  return status;
}

function statusClass(status: string): string {
  if (status === 'active') return 'border-accent/40 bg-accent/10 text-accent';
  return 'border-line bg-ink/5 text-ink-muted';
}
---

<BaseLayout
  title="Building — Alejandro Berrizbeitia"
  description="Public repositories and projects I work on."
>
  <main class="mx-auto max-w-2xl px-6 py-14 md:py-20">
    <h1 class="font-serif text-3xl font-semibold text-ink">Building</h1>
    <p class="mt-4 leading-relaxed text-ink-body">
      Public repositories and projects I work on.
    </p>

    <ul class="mt-12 space-y-8">
      {
        projects.map((p) => (
          <li class="border-b border-line pb-8 last:border-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <a
                href={p.repo_url}
                class="font-mono text-lg font-medium text-accent hover:text-accent-hover hover:underline"
              >
                {p.slug}
              </a>
              <span
                class:list={[
                  'shrink-0 rounded border px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                  statusClass(p.status),
                ]}
              >
                {statusLabel(p.status)}
              </span>
            </div>
            <p class="mt-2 leading-relaxed text-ink-body">{p.one_liner}</p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
