---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { byFeaturedThenDate } from '../lib/fieldNotes';

const latestNotes = (await getCollection('cards')).sort(byFeaturedThenDate).slice(0, 3);

const sections = [
  {
    href: '/building/',
    title: 'Building',
    blurb: 'Public repositories and projects I work on.',
  },
  {
    href: '/writing/',
    title: 'Writing',
    blurb: 'Articles and essays on data, decisions, and analytics.',
  },
];
---

<BaseLayout
  title="Alejandro Berrizbeitia"
  description="Narratives in numbers. Forecasting, causal inference, and evaluation of AI-generated analyses."
>
  <main class="mx-auto max-w-2xl px-6 py-14 md:py-20">
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink md:text-4xl">
      Narratives in numbers.
    </h1>
    <p class="mt-3 font-serif text-lg text-ink-body md:text-xl">
      Forecasting, causal inference, and evaluation of AI-generated analyses.
    </p>
    <p class="mt-8 text-base leading-relaxed text-ink-body md:text-lg">
      I build forecasts using statistical and foundation models, study cause and effect through
      experiments and observational data, and check AI-generated analyses for accuracy and
      usefulness. I also design semantic layers so teams can use consistent definitions across
      their tools.
    </p>

    <!-- Field Notes leads with real titles rather than another blurb, so the
         page opens on something to read instead of four identical signposts. -->
    <section class="mt-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="font-serif text-xl font-semibold text-ink">Field Notes</h2>
        <a
          href="/field-notes/"
          class="text-sm font-medium text-accent underline underline-offset-4 hover:text-accent-hover"
        >
          All field notes →
        </a>
      </div>
      <p class="mt-3 leading-relaxed text-ink-body">
        Short notes on data and decisions, with examples from analytics work.
      </p>
      <ul class="mt-6 divide-y divide-line border-y border-line">
        {
          latestNotes.map((note) => (
            <li>
              <a href={`/field-notes/${note.slug}/`} class="group block py-4">
                <span class="font-serif text-lg text-ink group-hover:underline">
                  {note.data.title}
                </span>
                <span class="mt-1 block text-sm text-ink-muted">
                  {note.data.date.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                  {note.data.tag && ` · ${note.data.tag}`}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-14 grid gap-10 sm:grid-cols-2 sm:gap-8">
      {
        sections.map(({ href, title, blurb }) => (
          <section>
            <h2 class="font-serif text-xl font-semibold text-ink">{title}</h2>
            <p class="mt-2 leading-relaxed text-ink-body">{blurb}</p>
            <p class="mt-3">
              <a
                href={href}
                class="font-medium text-accent underline underline-offset-4 hover:text-accent-hover"
              >
                View {title.toLowerCase()} →
              </a>
            </p>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
