---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
---

<BaseLayout
  title="About — Alejandro Berrizbeitia"
  description="Senior Data Analyst at Kit and Time Series and Forecasting professor at IE University. Forecasting, causal inference, and AI-assisted analytics evaluation."
>
  <main class="mx-auto max-w-2xl px-6 py-14 md:py-20">
    <h1 class="font-serif text-3xl font-semibold text-midnight dark:text-silver">About</h1>

    <div
      class="mt-10 space-y-4 border-l-2 border-silver/60 pl-6 text-lg leading-relaxed text-ink-muted dark:border-silver/30 dark:text-silver"
    >
      <p>
        I am a Senior Data Analyst at Kit and a Time Series and Forecasting professor at IE
        University.
      </p>
      <p>
        Most analytics questions are causal. Most analytics methods are only descriptive. Eighteen
        years across data, operations, finance, and sales made that gap impossible to ignore.
      </p>
      <p>
        My work produces forecasts across statistical and foundation models, causal readouts from
        experiments and observational studies, and evaluations of AI-generated analyses for
        correctness and decision-readiness. The goal: output a team can act on.
      </p>
      <p>
        Public work lives in <a
          href="https://github.com/aleberriz/intelligence-layer"
          class="text-midnight underline dark:text-silver">intelligence-layer</a
        >, a practitioner knowledge base on decision science methods, and <a
          href="https://github.com/aleberriz/agent-skills"
          class="text-midnight underline dark:text-silver">agent-skills</a
        >, reusable AI skill definitions for analytics workflows. I also write
        for the <a
          href={siteConfig.ieBlogPostUrl}
          class="text-midnight underline dark:text-silver">IE University blog</a
        >.
      </p>
      <p>
        MEng in Telecommunications from UPC (Barcelona School of Telecommunications Engineering,
        Universitat Politecnica de Catalunya). MBA from Florida International University.
        OKR Master (Betterworks). Trilingual: EN / ES / FR. FOSS-leaning. Perpetually reading.
      </p>
    </div>

    <section class="mt-12">
      <h2 class="font-serif text-lg font-semibold text-midnight dark:text-silver">Links</h2>
      <ul class="mt-3 space-y-2 text-ink-muted dark:text-silver">
        <li>
          <a href={siteConfig.githubProfile} class="text-midnight underline dark:text-silver"
            >GitHub</a
          >
        </li>
        <li>
          <a href={siteConfig.linkedinUrl} class="text-midnight underline dark:text-silver">
            LinkedIn
          </a>
        </li>
        {
          siteConfig.kitNewsletterUrl && (
            <li>
              <a href={siteConfig.kitNewsletterUrl} class="text-midnight underline dark:text-silver">
                Newsletter — <cite class="not-italic">The Trade-off</cite>
              </a>
            </li>
          )
        }
        <li>
          <a href="/writing/" class="text-midnight underline dark:text-silver">Writing</a>
        </li>
        <li>
          <a href="/field-notes/" class="text-midnight underline dark:text-silver">Field Notes</a>
        </li>
      </ul>
    </section>

    <p class="mt-14 text-sm text-ink-muted dark:text-silver">
      AWS Certified AI Practitioner.
    </p>
  </main>
</BaseLayout>
