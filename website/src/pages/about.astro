---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';

const linkClass = 'text-accent underline underline-offset-4 hover:text-accent-hover';
---

<BaseLayout
  title="About — Alejandro Berrizbeitia"
  description="Data Analyst at Kit and Time Series and Forecasting professor at IE University. Forecasting, causal inference, and AI-assisted analytics evaluation."
>
  <main class="mx-auto max-w-2xl px-6 py-14 md:py-20">
    <h1 class="font-serif text-3xl font-semibold text-ink">About</h1>

    <!--
      The headshot stacks above the bio on phones. It used to be `hidden
      sm:block`, which meant no phone ever showed it, on the one page where
      the photo does the most work.
    -->
    <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start">
      <!--
        Phones get the 95KB file instead of the 325KB one. At 112px wide that
        is still a 1.9x render, so nothing visible is lost. `eager` because on
        mobile the photo now sits above the fold.
      -->
      <picture class="shrink-0">
        <source media="(max-width: 639px)" srcset="/headshot-small.png" />
        <img
          src="/headshot.png"
          alt="Alejandro Berrizbeitia"
          width="140"
          height="187"
          class="w-28 rounded-lg sm:w-[140px]"
          loading="eager"
          decoding="async"
        />
      </picture>
      <div
        class="space-y-4 border-line pl-0 text-base leading-relaxed text-ink-body sm:border-l-2 sm:pl-6 md:text-lg"
      >
        <p>
          I am a Data Analyst at <a
            href="https://kit.com"
            class={linkClass}>Kit</a
          > and a Time Series and Forecasting professor at
          <a
            href="https://www.ie.edu/university/studies/academic-programs/dual-degree-in-business-administration-data-and-business-analytics/the-program/"
            class={linkClass}>IE University</a
          >.
        </p>
        <p>
          Most analytics questions are causal. Most analytics methods are only descriptive. Eighteen
          years across data, operations, finance, and sales made that gap impossible to ignore.
        </p>
        <p>
          I build forecasts across statistical and foundation models, causal readouts from
          experiments and observational studies, and evaluations of AI-generated analyses for
          correctness and decision-readiness. The goal: analysis a team can act on.
        </p>
        <p>
          My public repos are <a
            href="https://github.com/aleberriz/intelligence-layer"
            class={linkClass}>intelligence-layer</a
          >, a practitioner knowledge base on decision science methods, and <a
            href="https://github.com/aleberriz/agent-skills"
            class={linkClass}>agent-skills</a
          >, reusable AI skill definitions for analytics workflows. I have also written for the <a
            href={siteConfig.ieBlogPostUrl}
            class={linkClass}>IE University blog</a
          >.
        </p>
        <p>
          MEng in Telecommunications from <a href="https://telecos.upc.edu/en" class={linkClass}
            >ETSETB-UPC</a
          > (Barcelona School of Telecommunications Engineering, BarcelonaTech). MBA from the <a
            href="https://business.fiu.edu/index.html"
            class={linkClass}>FIU College of Business</a
          > (Florida International University). OKR Master (Betterworks). Trilingual: EN / ES / FR.
          FOSS-leaning. Perpetually reading.
        </p>
      </div>
    </div>

    <section class="mt-12">
      <h2 class="font-serif text-lg font-semibold text-ink">Links</h2>
      <ul class="mt-3 space-y-2 text-ink-body">
        <li><a href={siteConfig.githubProfile} class={linkClass}>GitHub</a></li>
        <li><a href={siteConfig.linkedinUrl} class={linkClass}>LinkedIn</a></li>
        {
          siteConfig.kitNewsletterUrl && (
            <li>
              <a href={siteConfig.kitNewsletterUrl} class={linkClass}>
                Newsletter — <cite class="not-italic">The Trade-off</cite>
              </a>
            </li>
          )
        }
      </ul>
    </section>
  </main>
</BaseLayout>
