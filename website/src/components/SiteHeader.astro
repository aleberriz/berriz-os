---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/building/', label: 'Building' },
  { href: '/writing/', label: 'Writing' },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/about/', label: 'About' },
] as const;

function active(href: string): boolean {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href.replace(/\/$/, ''));
}
---

<header class="border-b border-line">
  <!--
    The name and the nav stack on phones: fitting both on one line at 375px
    wrapped the name and jammed the links against it. The toggle is pinned to
    the name row on mobile so the nav gets the full width and all five links
    stay on one line.
  -->
  <div
    class="relative mx-auto flex max-w-3xl flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:gap-5"
  >
    <a href="/" class="font-serif text-lg font-semibold tracking-tight text-ink"
      >Alejandro Berrizbeitia</a
    >

    <nav
      class="flex flex-wrap gap-x-3 gap-y-1 text-sm font-medium sm:ml-auto sm:justify-end sm:gap-x-5"
    >
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={active(href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-ink',
              active(href) ? 'text-ink' : 'text-ink-muted',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="absolute right-[1.125rem] top-4 sm:static sm:right-auto sm:top-auto">
      <ThemeToggle />
    </div>
  </div>
</header>
