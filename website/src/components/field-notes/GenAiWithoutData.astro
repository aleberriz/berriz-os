    border-top: 1px solid var(--rule);
  }
  .gnd-card h2,
  .gnd-close h2 {
    margin: 0.55rem 0 1.2rem;
    font-family: 'Archivo Black', Archivo, Inter, sans-serif;
    font-size: clamp(1.5rem, 6.2vw, 2.05rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }

  .gnd-note {
    margin-top: 1.5rem;
    padding: 0.9rem 0 0.9rem 1.1rem;
