              <rect x="56" y="26" width="52" height="14" class="g-pool" />
              <path d="M120 40 V24" class="g-thin" />
              <path d="M107 24 L133 24 L120 11 Z" class="g-para" />
              <path d="M158 18 V13" class="g-thin" />
              <path d="M150 13 L166 13 L158 7 Z" class="g-para" />
              <!-- windows -->
              <g class="g-win">
                <rect x="50" y="58" width="16" height="20" />
                <rect x="74" y="58" width="16" height="20" />
                <rect x="98" y="58" width="16" height="20" />
                <rect x="122" y="58" width="16" height="20" />
                <rect x="146" y="58" width="16" height="20" />
                <rect x="170" y="58" width="16" height="20" />
                <rect x="50" y="88" width="16" height="20" />
                <rect x="74" y="88" width="16" height="20" />
                <rect x="122" y="88" width="16" height="20" />
                <rect x="146" y="88" width="16" height="20" />
                <rect x="170" y="88" width="16" height="20" />
                <rect x="50" y="118" width="16" height="20" />
                <rect x="98" y="118" width="16" height="20" />
                <rect x="146" y="118" width="16" height="20" />
                <rect x="170" y="118" width="16" height="20" />
              </g>
              <!-- cracks -->
              <path d="M96 88 l8 14 -7 10 9 16 -6 12" class="g-crack" />
              <path d="M188 46 l-6 18 8 14 -5 20" class="g-crack" />
            </g>

            <!-- piles: crossed, snapped, short of rock -->
            <g class="g-pile">
              <path d="M52 150 L86 236" />
              <path d="M96 150 L58 230" />
              <path d="M112 150 L140 244" />
              <path d="M170 150 L146 214" />
              <path d="M158 226 L150 252" />
              <path d="M196 150 L214 218" />
              <path d="M214 232 L206 258" />
