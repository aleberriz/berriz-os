            <g class="g-block">
              <rect x="86" y="150" width="90" height="154" />
              <path d="M86 176 h90 M86 202 h90 M86 228 h90 M86 254 h90 M86 280 h90" class="g-joint" />
              <path
                d="M116 150 v26 M146 150 v26 M101 176 v26 M131 176 v26 M161 176 v26 M116 202 v26 M146 202 v26 M101 228 v26 M131 228 v26 M161 228 v26 M116 254 v26 M146 254 v26 M101 280 v24 M131 280 v24 M161 280 v24"
                class="g-joint"
              />
