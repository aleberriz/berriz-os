---
/**
 * Field note series: the Operational Governance Knowledge Flashcards.
 * → /field-notes/<slug>/ for every card in src/data/opgovFlashcards.ts
 *
 * One shared design for the whole series — the deliberate exception to the
 * "two custom notes should not look like each other" rule. The set reads as
 * a deck of ruled index cards from the archive: cream paper, a red double
 * rule under the header, faint horizontal rules down the body, punch holes
 * on the left, and a small series stamp acknowledging the legacy
 * ("Operational Governance" — we'd call it BizOps today).
 *
 * Every card renders through this component only; the content lives in
 * src/data/opgovFlashcards.ts, keyed by slug. Fraunces and Inter are loaded
 * site-wide by ThemeHead; Courier Prime is imported here.
 */
import type { Block, OpGovCard } from '../../data/opgovFlashcards';
import { OPGOV_TOTAL } from '../../data/opgovFlashcards';

interface Props {
  card: OpGovCard;
}

const { card } = Astro.props;

const num = String(card.number).padStart(2, '0');
const total = String(OPGOV_TOTAL).padStart(2, '0');

function esc(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/** Minimal inline markup: **bold**, *italic*, `code`, [label](url). */
function inline(s: string): string {
  return esc(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
}

function renderBlocks(blocks: Block[]): string {
  return blocks
    .map((b) => {
      switch (b.kind) {
        case 'p':
          return `<p>${inline(b.text)}</p>`;
        case 'note':
          return `<p class="ogf-note">${inline(b.text)}</p>`;
        case 'list': {
          const tag = b.ordered ? 'ol' : 'ul';
          const items = b.items.map((i) => `<li>${inline(i)}</li>`).join('');
          return `<${tag}>${items}</${tag}>`;
        }
        case 'quote':
          return `<blockquote><p>${inline(b.text)}</p>${
            b.source ? `<cite>${inline(b.source)}</cite>` : ''
          }</blockquote>`;
        case 'table':
          return `<div class="ogf-twrap"><table><thead><tr>${b.head
            .map((h) => `<th>${inline(h)}</th>`)
            .join('')}</tr></thead><tbody>${b.rows
            .map((r) => `<tr>${r.map((c) => `<td>${inline(c)}</td>`).join('')}</tr>`)
            .join('')}</tbody></table></div>`;
        case 'sub':
          return `<div class="ogf-sub"><h3>${inline(
            b.heading,
          )}</h3>${renderBlocks(b.blocks)}</div>`;
        case 'quadrant': {
          const cellHtml = (c: (typeof b.cells)[number]) =>
            `<div class="ogf-quad-cell"><p class="ogf-quad-h">${inline(c.heading)}</p>${
              c.items
                ? `<ul>${c.items.map((i) => `<li>${inline(i)}</li>`).join('')}</ul>`
                : c.text
                  ? `<p>${inline(c.text)}</p>`
                  : ''
            }</div>`;
          const [tl, tr, bl, br] = b.cells;
          const rowLabel = (t: string) => `<span class="ogf-quad-row">${inline(t)}</span>`;
          const colLabels = b.colLabels
            ? `<div class="ogf-quad-cols" aria-hidden="true"><span>${inline(
                b.colLabels[0],
              )}</span><span>${inline(b.colLabels[1])}</span></div>`
            : '';
          return `<div class="ogf-quad">${colLabels}<div class="ogf-quad-grid">
            ${b.rowLabels ? rowLabel(b.rowLabels[0]) : ''}
            ${cellHtml(tl)}${cellHtml(tr)}
            ${b.rowLabels ? rowLabel(b.rowLabels[1]) : ''}
            ${cellHtml(bl)}${cellHtml(br)}
          </div></div>`;
        }
        case 'stages': {
          const steps = b.steps
            .map(
              (s, i) =>
                `<li class="ogf-stage"><span class="ogf-stage-n">${i + 1}</span><span class="ogf-stage-b"><span class="ogf-stage-l">${inline(
                  s.label,
                )}</span>${s.text ? `<span class="ogf-stage-t">${inline(s.text)}</span>` : ''}</span></li>`,
            )
            .join('');
          return `<ol class="ogf-stages${b.loop ? ' ogf-stages--loop' : ''}">${steps}</ol>${
            b.loop
              ? `<p class="ogf-stage-loop">↺ ${inline(b.loopLabel ?? 'repeats')}</p>`
              : ''
          }`;
        }
        case 'boxplot':
          return `<div class="ogf-boxplot">
            <svg viewBox="0 0 340 120" role="img" aria-label="Box-and-whisker plot showing the five-number summary">
              <line x1="20" y1="60" x2="90" y2="60" class="ogf-bp-whisker" />
              <line x1="20" y1="42" x2="20" y2="78" class="ogf-bp-whisker" />
              <rect x="90" y="30" width="110" height="60" class="ogf-bp-box" />
              <line x1="150" y1="30" x2="150" y2="90" class="ogf-bp-median" />
              <line x1="200" y1="60" x2="300" y2="60" class="ogf-bp-whisker" />
              <line x1="300" y1="42" x2="300" y2="78" class="ogf-bp-whisker" />
              <text x="20" y="105" class="ogf-bp-label" text-anchor="middle">“Minimum”</text>
              <text x="90" y="105" class="ogf-bp-label" text-anchor="middle">Q1</text>
              <text x="150" y="105" class="ogf-bp-label" text-anchor="middle">Median</text>
              <text x="200" y="105" class="ogf-bp-label" text-anchor="middle">Q3</text>
              <text x="300" y="105" class="ogf-bp-label" text-anchor="middle">“Maximum”</text>
              <text x="145" y="18" class="ogf-bp-label" text-anchor="middle">Interquartile range (IQR)</text>
              <line x1="90" y1="24" x2="200" y2="24" class="ogf-bp-iqr" />
            </svg>
          </div>`;
        case 'shapes': {
          const shapeHtml = (kind: string) => {
            if (kind === 'oval') return `<span class="ogf-shape ogf-shape--oval"></span>`;
            if (kind === 'diamond') return `<span class="ogf-shape ogf-shape--diamond"></span>`;
            if (kind === 'parallelogram') return `<span class="ogf-shape ogf-shape--parallelogram"></span>`;
            return `<span class="ogf-shape ogf-shape--rect"></span>`;
          };
          return `<ul class="ogf-shapes">${b.items
            .map(
              (it) =>
                `<li>${shapeHtml(it.shape)}<span class="ogf-shape-b"><span class="ogf-shape-l">${inline(
                  it.label,
                )}</span><span class="ogf-shape-d">${inline(it.desc)}</span></span></li>`,
            )
            .join('')}</ul>`;
        }
      }
    })
    .join('');
}

const bylineNames = (card.bylines ?? [])
  .map((b) => (b.url ? `<a href="${b.url}">${esc(b.name)}</a>` : esc(b.name)))
  .join(' &amp; ');
---

<div class="ogf">
  <div class="ogf-inner">
    <article class="ogf-card">
      <span class="ogf-hole ogf-hole--1" aria-hidden="true"></span>
      <span class="ogf-hole ogf-hole--2" aria-hidden="true"></span>
      <span class="ogf-hole ogf-hole--3" aria-hidden="true"></span>

      <header class="ogf-head">
        <p class="ogf-kicker">
          Operational Governance Knowledge Flashcards
          <span class="ogf-stamp">No. {num}/{total}</span>
        </p>
        <h1 class="ogf-title">{card.title}</h1>
        <p class="ogf-legacy">
          From the Operational Governance flashcard deck; today this
          discipline goes by BizOps. The original card is republished here
          as a field note.
        </p>
      </header>
      <div class="ogf-redline" aria-hidden="true"></div>

      {
        card.sections.map((section, i) => (
          <section class="ogf-sec">
            <h2 class="ogf-sec-h">
              <span class="ogf-sec-num">{String(i + 1).padStart(2, '0')}</span>
              {section.heading}
            </h2>
            <div class="ogf-sec-b" set:html={renderBlocks(section.blocks)} />
          </section>
        ))
      }

      <footer class="ogf-foot">
        {
          bylineNames && (
            <p class="ogf-byline">
              Flashcard by <span set:html={bylineNames} /> · {card.originalDate}
            </p>
          )
        }
        {!bylineNames && <p class="ogf-byline">Flashcard · {card.originalDate}</p>}
        <p class="ogf-backlink">
          <a href="/field-notes/">← All field notes</a>
          <a href="/field-notes/">aleberriz.com</a>
        </p>
      </footer>
    </article>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap');

  .ogf {
    --paper: #f8f3e4;
    --desk: #e8e0c8;
    --ink: #32302a;
    --ink-soft: #56503f;
    --ink-dim: #7c7560;
    --rule: rgba(96, 116, 143, 0.28);
    --rule-strong: rgba(96, 116, 143, 0.45);
    --red: #b23a2f;

    min-height: 100vh;
    padding: 2rem 1rem 4rem;
    background:
      radial-gradient(1200px 400px at 50% -100px, rgba(255, 252, 240, 0.7), transparent),
      var(--desk);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 1.03rem;
    line-height: 1.62;
  }

  .ogf-inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  /* ---- the index card ---- */
  .ogf-card {
    position: relative;
    padding: 2.6rem 1.6rem 2.2rem 2.9rem;
    background: var(--paper);
    border: 1px solid #d9cfa9;
    border-radius: 4px;
    box-shadow:
      0 1px 2px rgba(80, 66, 30, 0.12),
      0 14px 34px rgba(80, 66, 30, 0.2);
  }

  @media (min-width: 640px) {
    .ogf-card { padding: 3.2rem 3rem 2.6rem 4.2rem; }
  }

  /* punch holes down the left margin */
  .ogf-hole {
    position: absolute;
    left: 0.9rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--desk);
    box-shadow:
      inset 0 1.5px 3px rgba(60, 48, 20, 0.4),
      0 1px 0 rgba(255, 255, 255, 0.65);
  }
  .ogf-hole--1 { top: 4.5rem; }
  .ogf-hole--2 { top: 50%; margin-top: -0.42rem; }
  .ogf-hole--3 { bottom: 4.5rem; }

  @media (max-width: 420px) {
    .ogf-hole { left: 0.5rem; width: 0.65rem; height: 0.65rem; }
    .ogf-hole--2 { margin-top: -0.32rem; }
    .ogf-card { padding-left: 2rem; }
  }

  /* ---- header ---- */
  .ogf-head { margin-bottom: 1.1rem; }

  .ogf-kicker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .ogf-stamp {
    flex: none;
    padding: 0.14rem 0.5rem;
    border: 1.5px solid var(--red);
    border-radius: 3px;
    color: var(--red);
    transform: rotate(-2deg);
    font-weight: 700;
  }

  .ogf-title {
    margin: 0.9rem 0 0.7rem;
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(2rem, 8vw, 2.9rem);
    font-weight: 600;
    line-height: 1.06;
    color: #2a2822;
  }

  .ogf-legacy {
    margin: 0;
    max-width: 46ch;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-dim);
  }

  /* the red double rule of a ruled index card */
  .ogf-redline {
    height: 2px;
    background: var(--red);
    margin: 1.4rem 0 0;
  }
  .ogf-redline::after {
    content: '';
    display: block;
    height: 1px;
    background: var(--red);
    margin-top: 3px;
  }

  /* ---- sections ---- */
  .ogf-sec { padding: 1.9rem 0 0.5rem; }

  .ogf-sec-h {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 0.9rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--rule-strong);
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2a2822;
  }
  .ogf-sec-num {
    font-size: 0.78rem;
    color: var(--red);
    letter-spacing: 0.06em;
  }

  /* the ruled-paper feel: every block sits on a faint horizontal rule,
     with enough air between blocks to read without bullet markers */
  .ogf-sec-b > p,
  .ogf-sec-b > ul,
  .ogf-sec-b > ol,
  .ogf-sec-b > blockquote,
  .ogf-sec-b > .ogf-twrap,
  .ogf-sec-b > .ogf-sub,
  .ogf-sec-b > .ogf-quad,
  .ogf-sec-b > .ogf-stages,
  .ogf-sec-b > .ogf-boxplot,
  .ogf-sec-b > .ogf-shapes {
    margin: 0 0 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .ogf-sec-b > *:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }

  .ogf-sec-b p { margin: 0; }
  .ogf-sec-b p + p { margin-top: 1.1rem; }

  .ogf a { color: #29527a; text-decoration: underline; text-underline-offset: 3px; }
  .ogf a:hover { color: var(--red); }

  .ogf ul, .ogf ol { padding-left: 1.3rem; margin: 0; }
  .ogf li { margin: 0.25rem 0; }
  .ogf li::marker { color: var(--red); }

  .ogf strong { color: #2a2822; }
  .ogf code {
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.92em;
    background: rgba(96, 116, 143, 0.12);
    border-radius: 3px;
    padding: 0.08em 0.3em;
  }

  .ogf blockquote { margin: 0; padding: 0.15rem 0 0.9rem 1.1rem; border-left: 3px solid var(--red); }
  .ogf blockquote p {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.12rem;
    font-style: italic;
    color: #3c382e;
  }
  .ogf blockquote cite {
    display: block;
    margin-top: 0.4rem;
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .ogf-note {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--ink-dim);
  }

  .ogf-sub h3 {
    margin: 0 0 0.5rem;
    font-family: Fraunces, Georgia, serif;
    font-size: 1.12rem;
    font-weight: 600;
    color: #2a2822;
  }
  .ogf-sub > ul,
  .ogf-sub > ol,
  .ogf-sub > p { margin: 0 0 0.8rem; }
  .ogf-sub > *:last-child { margin-bottom: 0; }

  .ogf-twrap { overflow-x: auto; }
  .ogf table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .ogf th, .ogf td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.7rem 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .ogf th {
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  /* ---- quadrant diagram ---- */
  .ogf-quad-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0 0 0.4rem 2.1rem;
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-align: center;
  }
  .ogf-quad-grid {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    grid-auto-rows: auto;
    gap: 0.6rem;
    align-items: stretch;
  }
  .ogf-quad-row {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ogf-quad-cell {
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.35);
  }
  .ogf-quad-h {
    margin: 0 0 0.4rem;
    font-family: Fraunces, Georgia, serif;
    font-size: 1.02rem;
    font-weight: 600;
    color: #2a2822;
  }
  .ogf-quad-cell p { margin: 0; font-size: 0.92rem; }
  .ogf-quad-cell ul { margin: 0; padding-left: 1.1rem; font-size: 0.92rem; }
  .ogf-quad-cell li { margin: 0.15rem 0; }
  @media (max-width: 520px) {
    .ogf-quad-grid { grid-template-columns: auto 1fr; }
    .ogf-quad-grid > .ogf-quad-cell:nth-of-type(2) { grid-column: 2; }
  }

  /* ---- stages diagram ---- */
  .ogf-stages { list-style: none; margin: 0; padding: 0 !important; }
  .ogf-stage::marker { content: none; }
  .ogf-stage {
    position: relative;
    display: flex;
    gap: 0.9rem;
    padding: 0 0 1.3rem 0;
    margin: 0;
  }
  .ogf-stage:last-child { padding-bottom: 0; }
  .ogf-stage::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 1.9rem;
    bottom: 0.1rem;
    width: 1px;
    background: var(--rule-strong);
  }
  .ogf-stage:last-child::before { display: none; }
  .ogf-stages--loop .ogf-stage:last-child::before {
    display: block;
    background: transparent;
  }
  .ogf-stage-n {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 1.5px solid var(--red);
    color: var(--red);
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    background: var(--paper);
    z-index: 1;
  }
  .ogf-stage-b { display: flex; flex-direction: column; gap: 0.15rem; padding-top: 0.15rem; }
  .ogf-stage-l { font-family: Fraunces, Georgia, serif; font-weight: 600; font-size: 1.02rem; color: #2a2822; }
  .ogf-stage-t { font-size: 0.9rem; color: var(--ink-soft); }
  .ogf-stage-loop {
    margin: 0.2rem 0 0 2.5rem;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--ink-dim);
  }

  /* ---- box plot diagram ---- */
  .ogf-boxplot { width: 100%; }
  .ogf-boxplot svg { width: 100%; height: auto; overflow: visible; }
  .ogf-bp-whisker, .ogf-bp-median, .ogf-bp-iqr { stroke: var(--ink); fill: none; }
  .ogf-bp-whisker { stroke-width: 1.5; }
  .ogf-bp-median { stroke: var(--red); stroke-width: 2; }
  .ogf-bp-iqr { stroke: var(--ink-dim); stroke-width: 1; }
  .ogf-bp-box { fill: rgba(178, 58, 47, 0.12); stroke: var(--ink); stroke-width: 1.5; }
  .ogf-bp-label {
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 8px;
    fill: var(--ink-soft);
  }

  /* ---- flowchart shape legend ---- */
  .ogf-shapes { list-style: none; margin: 0; padding: 0; }
  .ogf-shapes li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .ogf-shapes li:last-child { border-bottom: 0; }
  .ogf-shape { flex: none; display: block; width: 2.4rem; height: 1.5rem; border: 1.5px solid var(--ink); background: rgba(178, 58, 47, 0.1); }
  .ogf-shape--oval { border-radius: 50%; }
  .ogf-shape--diamond { border-radius: 3px; transform: rotate(45deg); width: 1.2rem; height: 1.2rem; margin: 0 0.6rem; }
  .ogf-shape--parallelogram { transform: skewX(-18deg); }
  .ogf-shape-b { display: flex; flex-direction: column; gap: 0.1rem; }
  .ogf-shape-l { font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.76rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim); }
  .ogf-shape-d { font-size: 0.92rem; }

  /* ---- footer ---- */
  .ogf-foot {
    margin-top: 2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule-strong);
  }
  .ogf-byline {
    margin: 0 0 0.5rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }
  .ogf-byline a { color: #29527a; }
  .ogf-backlink {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-family: 'Courier Prime', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ogf-backlink a { color: var(--ink-dim); }
  .ogf-backlink a:hover { color: var(--red); }

  /* ---- present mode ---- */
  :global(html.present) .ogf-backlink { display: none; }
