---
import { siteConfig } from '../site.config';

const year = new Date().getFullYear();

const links = [
  { href: siteConfig.githubProfile, label: 'GitHub' },
  { href: siteConfig.linkedinUrl, label: 'LinkedIn' },
  { href: 'https://github.com/aleberriz/berriz-os', label: 'berriz-os' },
];
---

<footer class="mt-20 border-t border-line px-6 py-10 text-center text-sm text-ink-muted">
  <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1">
    {
      links.map(({ href, label }, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a href={href} class="text-accent underline underline-offset-4 hover:text-accent-hover">
            {label}
          </a>
        </>
      ))
    }
  </nav>
  <p class="mt-3">{year}</p>
</footer>
