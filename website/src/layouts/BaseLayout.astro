---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeHead from '../components/ThemeHead.astro';

interface Props {
  title: string;
  description?: string;
}

const canonical = new URL(Astro.url.pathname, Astro.site);
const {
  title,
  description = 'Data scientist working at the intersection of forecasting, causal inference, and AI-assisted analytics evaluation.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeHead title={title} description={description} canonical={canonical} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-ink-body antialiased">
    <SiteHeader />
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>
